# Panel
PORT=8090
PANEL_TITLE=Grupo Presidente - Monitoreo de Redes
PANEL_COMPANY=Grupo Presidente
PANEL_SUBTITLE=Monitoreo de Redes
PANEL_USER=admin
PANEL_PASSWORD=cambiar-esta-clave
PANEL_AUTH_DISABLED=false

# Uptime Kuma
# Usar la URL interna cuando sea posible, por ejemplo:
# KUMA_URL=http://192.168.68.50:3001
KUMA_URL=https://resolve-yards-quickly-relatives.trycloudflare.com
KUMA_USERNAME=admin
KUMA_PASSWORD=cambiar-esta-clave
KUMA_STATUS_SLUG=general
# Poner en true solo si la URL interna usa HTTPS con certificado autofirmado.
KUMA_INSECURE_TLS=false

# Cache
KUMA_BADGE_7D_TTL_MS=300000
INCIDENTS_TTL_MS=300000

# Zona horaria del panel
TZ=America/Argentina/Buenos_Aires
